# ============================================================
# GreenTalk — Environment Variables
# ============================================================
# Copy this file to .env in the project root and fill in values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- PostgreSQL Connection ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=blog
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Django Secret Key ---
DJANGO_SECRET_KEY=change_me_to_a_long_random_string_at_least_50_chars

# --- Django Environment ---
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email (Dev: console backend) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@greentalk.local

# --- Email (Prod: Gmail SMTP App Password — uncomment for production) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_gmail@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password
# DEFAULT_FROM_EMAIL=GreenTalk <your_gmail@gmail.com>

# --- Media & Static Files ---
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# --- JWT / Token Auth ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- PostgreSQL Tested Version ---
# Tested with: PostgreSQL 17.x (see DATABASE.md for exact patch)
# Python driver: psycopg2-binary==2.9.10
