# ============================================================
# GreenTalk Frontend — Environment Variables
# Copy to .env.development (local) or .env.production (prod)
# Vite only exposes variables prefixed with VITE_
# NEVER put secrets here — these are bundled into the client
# ============================================================

# API base URL — in dev the Vite proxy handles /api routing
# so this can be empty or set explicitly
VITE_API_BASE_URL=http://localhost:8000

# App name (used in page titles)
VITE_APP_NAME=GreenTalk

# App description (used in default meta tags)
VITE_APP_DESCRIPTION=Community blog and plant exchange platform

# Frontend base URL (used for canonical links, OG tags)
VITE_APP_URL=http://localhost:3000
