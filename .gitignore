# ============================================================
# GreenTalk — Root .gitignore
# ============================================================

# ---- Python / Django ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# CRITICAL: Never commit real credentials
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
frontend/.env.test.local

# Commit .env.example (placeholders only) — never commit .env
!backend/.env.example
!frontend/.env.example
!frontend/.env.development
!frontend/.env.production

# Django media uploads (user-generated content — not in repo)
backend/media/
!backend/media/.gitkeep

# Django static files (generated by collectstatic)
backend/staticfiles/

# Test coverage
backend/htmlcov/
frontend/coverage/
frontend/htmlcov/
.coverage
.coverage.*
coverage.xml

# pytest
backend/.pytest_cache/
.pytest_cache/

# ---- Node / React ----
frontend/node_modules/
frontend/dist/
frontend/.DS_Store

# ---- Editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ---- Database backups (store separately, not in repo) ----
*.dump
*.sql.gz

# ---- Misc ----
*.pid
*.seed
*.pid.lock
